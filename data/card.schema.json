{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DH Katastrophen TCG card",
  "type": "object",
  "required": [
    "card_id",
    "name",
    "domain_primary",
    "rarity",
    "card_type"
  ],
  "properties": {
    "card_id": {
      "type": "string",
      "pattern": "^KAT-[CUMRBX][0-9]{2}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "domain_primary": {
      "enum": [
        "team",
        "data",
        "operations",
        "methods",
        "neutral"
      ]
    },
    "domain_secondary": {
      "enum": [
        "",
        "team",
        "data",
        "operations",
        "methods"
      ]
    },
    "editorial_tags": {
      "description": "Redaktionelle Sekundaertags, mit + getrennt, in der Reihenfolge aus docs/13-redaktionelle-tags.md, hoechstens drei. Keine Spielressource.",
      "type": "string",
      "pattern": "^$|^(rights|access|accessibility|participation|provenance|care|labor|interpretation)(\\+(rights|access|accessibility|participation|provenance|care|labor|interpretation)){0,2}$"
    },
    "rarity": {
      "enum": [
        "common",
        "uncommon",
        "rare",
        "mythic",
        "basic",
        "reference"
      ]
    },
    "card_type": {
      "type": "string"
    },
    "foil_only": {
      "type": "boolean"
    },
    "stage_candidate": {
      "type": "boolean"
    }
  }
}
